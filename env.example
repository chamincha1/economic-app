# Copy this to .env; NEVER commit .env or paste the key in a chat.
# GroqCloud API key. No key = stock/CSV/quant features still work.
GROQ_API_KEY=
# Larger model prioritized for careful Korean article analysis.
GROQ_MODEL=openai/gpt-oss-120b

# Optional local safety cap on AI requests per KST day (not a provider billing limit).
GROQ_DAILY_REQUEST_CAP=24
